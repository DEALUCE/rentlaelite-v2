---
import Layout from '../layouts/Layout.astro';

import RelatedLinks from '../components/RelatedLinks.astro';
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "RealEstateListing",
    "name": "Production & Talent Housing Los Angeles — 9432 Oakmore Rd, Beverlywood",
    "description": "Private gated residence for production talent, showrunners, and studio executives on Los Angeles assignments. 12 minutes from the Fox Studio Lot, 15 from Century City agencies. 5BR furnished compound with staff guest house, no street line-of-sight, 30-90 day terms.",
    "url": "https://sevennova.ai/production-housing-los-angeles",
    "price": "34999",
    "priceCurrency": "USD",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "9432 & 9430 Oakmore Rd",
      "addressLocality": "Los Angeles",
      "addressRegion": "CA",
      "postalCode": "90035",
      "addressCountry": "US"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Which studios and production hubs are near the residence?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "9432 Oakmore Rd sits inside the Westside production triangle: the Fox Studio Lot on Pico is approximately 12 minutes away, Century City's agency corridor 15 minutes, Sony Pictures in Culver City roughly 15 minutes, and Fox's announced $1.5 billion lot expansion — nine additional soundstages — is set to deepen production activity in the immediate area through the decade."
        }
      },
      {
        "@type": "Question",
        "name": "What privacy protections does the property offer talent?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "The compound is perimeter-fenced with an automatic vehicle gate, no street line-of-sight into the residences, Ring camera coverage of every entry, smart locks with per-occupant access codes, and on-property parking for four vehicles behind the gate. The Beverlywood Homes Association maintains a contracted private patrol in the surrounding corridor. Inquiries are handled with confidentiality as standard practice."
        }
      },
      {
        "@type": "Question",
        "name": "Can security or an assistant live on-site?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The detached 400 sq ft guest house — private entrance, full bath, kitchenette, independent climate — is purpose-fit for a security detail, personal assistant, or trainer. It keeps support staff present without sharing the principal residence."
        }
      },
      {
        "@type": "Question",
        "name": "What terms suit a production schedule?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Terms begin at 30 days and flex with production calendars — extensions, hiatus gaps, and pickup schedules are accommodated month-to-month. $34,999 per month, fully furnished, gigabit fiber, move-in ready. Studio billing, loan-out corporations, and business-management payment arrangements are routine."
        }
      }
    ]
  }
];
---

<Layout
  title="Production & Talent Housing Los Angeles | Private Gated Compound — 12 Min to Fox Lot"
  description="Private gated residence for talent and production executives — 12 min to Fox Studio Lot, 15 to Century City agencies. 5BR furnished compound, staff guest house, no street line-of-sight, 30-90 day terms. Daniel Issak, DRE# 02037760."
  canonical="https://sevennova.ai/production-housing-los-angeles"
  jsonLd={jsonLd}
>
  <section class="relative py-28 bg-midnight-950 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-midnight-950 via-midnight-900 to-midnight-950"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <p class="text-amber-400 text-xs tracking-[0.4em] uppercase mb-4">Production · Talent · Discretion as Standard</p>
      <h1 class="font-display text-4xl md:text-5xl text-white leading-tight mb-6">
        Production Housing<br /><em class="text-gradient">Los Angeles</em>
      </h1>
      <p class="speakable text-slate-300 text-lg mb-8 max-w-2xl mx-auto leading-relaxed">
        A private, gated residence inside the Westside production triangle — 12 minutes to the Fox Studio Lot, 15 to Century City's agencies, 15 to Sony Culver City. Five bedrooms, a detached guest house for security or an assistant, no street line-of-sight, and terms that flex with a production calendar. 9432 Oakmore Rd, Beverlywood. $34,999 per month, 30-day minimum.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+14242725935" class="px-8 py-4 bg-amber-400 text-midnight-950 font-bold tracking-widest uppercase text-sm hover:bg-amber-300 transition-colors">Confidential Inquiry — 424-272-5935</a>
        <a href="/gallery" class="px-8 py-4 border border-amber-400 text-amber-400 font-bold tracking-widest uppercase text-sm hover:bg-amber-400 hover:text-midnight-950 transition-colors">View the Residence</a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-midnight-900">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-3xl text-white mb-8">The Westside Production Triangle</h2>
      <div class="space-y-6 text-slate-300 leading-relaxed">
        <p>Beverlywood sits quietly at the center of three production poles: the Fox Studio Lot on Pico Boulevard, the Century City agency corridor, and Sony Pictures in Culver City — each within a fifteen-minute radius. For talent and executives working a season on the Westside, the location removes the daily freeway question entirely.</p>
        <p>That radius is about to matter more. Fox has advanced a $1.5 billion expansion of its Century City lot — nine new soundstages bringing the total to twenty-four, plus more than two million square feet of new production facilities. As that capacity comes online, the demand for genuinely private housing within minutes of the lot deepens with it.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center mt-10">
        {[
          ['12 min', 'Fox Studio Lot'],
          ['15 min', 'Century City / CAA'],
          ['15 min', 'Sony Culver City'],
          ['20 min', 'Hollywood'],
        ].map(([val, label]) => (
          <div class="bg-midnight-950 p-5 border border-amber-400/10">
            <p class="font-display text-2xl text-amber-400">{val}</p>
            <p class="text-xs text-slate-500 tracking-widest uppercase mt-1">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-midnight-950">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-3xl text-white mb-8">Privacy, Engineered</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-slate-300">
        <div class="bg-midnight-900 p-6 border border-amber-400/10">
          <h3 class="font-display text-xl text-amber-400 mb-2">No Line-of-Sight</h3>
          <p class="text-sm">Perimeter fencing and mature landscaping remove street visibility into either residence. Vehicles enter behind an automatic gate; nothing is conducted in public view.</p>
        </div>
        <div class="bg-midnight-900 p-6 border border-amber-400/10">
          <h3 class="font-display text-xl text-amber-400 mb-2">Staff Quarters, Separated</h3>
          <p class="text-sm">The detached guest house gives a security detail or assistant a genuine residence — private entrance, full bath, kitchenette — present without proximity.</p>
        </div>
        <div class="bg-midnight-900 p-6 border border-amber-400/10">
          <h3 class="font-display text-xl text-amber-400 mb-2">Controlled Access</h3>
          <p class="text-sm">Smart locks issue per-person codes with full entry logs. Ring coverage on every approach. The surrounding corridor carries a contracted private patrol.</p>
        </div>
        <div class="bg-midnight-900 p-6 border border-amber-400/10">
          <h3 class="font-display text-xl text-amber-400 mb-2">Confidential Process</h3>
          <p class="text-sm">Inquiries handled broker-direct. Loan-out, studio, and business-management billing routine. Documentation same-day; showings private and by appointment only.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-midnight-900">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl text-white mb-6">Hold a Production Window</h2>
      <p class="text-slate-300 mb-8 max-w-2xl mx-auto">Business managers, production coordinators, and agency travel desks: the residence books by the window. Current availability — Fall 2026 onward and the Super Bowl LXI window, February 2027.</p>
      <p class="text-slate-500 text-sm mb-8">Daniel Issak · DRE #02037760 · Real Estate Source Inc.</p>
      <div class="flex flex-col md:flex-row gap-4 justify-center">
        <a href="tel:+14242725935" class="px-8 py-4 bg-amber-400 text-midnight-950 font-bold tracking-widest uppercase text-sm hover:bg-amber-300 transition-colors">Call 424-272-5935</a>
        <a href="/apply" class="px-8 py-4 border border-amber-400 text-amber-400 font-bold tracking-widest uppercase text-sm hover:bg-amber-400 hover:text-midnight-950 transition-colors">Reserve a Window</a>
      </div>
    </div>
  </section>

  <RelatedLinks heading="Specialized Housing" links={[{"label": "Corporate Housing LA", "href": "/corporate-housing-los-angeles", "sub": "Executive relocation and corporate leases"}, {"label": "Executive Rental Beverly Hills", "href": "/executive-rental-beverly-hills", "sub": "C-suite furnished housing"}, {"label": "Medical Stay Near Cedars-Sinai", "href": "/medical-stay-near-cedars-sinai", "sub": "Recovery and treatment housing"}, {"label": "Insurance / ALE Housing", "href": "/insurance-housing-los-angeles", "sub": "Additional Living Expense placements"}, {"label": "Kosher Kitchen Luxury Rental", "href": "/kosher-kitchen-luxury-rental-los-angeles", "sub": "Dual sinks, dual ovens, walk to shul"}]} />
</Layout>
