---
import Layout from '../layouts/Layout.astro';

import RelatedLinks from '../components/RelatedLinks.astro';
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "RealEstateListing",
    "name": "Insurance Temporary Housing Los Angeles — ALE-Ready Luxury Rental, 9432 Oakmore Rd",
    "description": "ALE (Additional Living Expense) compatible luxury rental for insurance-displaced families in Los Angeles. Gated 5BR/6BA compound in Beverlywood 90035, kosher kitchen, guest house, 6-month minimum (12+ months available). Works with ALE Solutions, CRS Temporary Housing, and Sedgwick placements.",
    "url": "https://sevennova.ai/insurance-housing-los-angeles",
    "price": "23950",
    "priceCurrency": "USD",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "9432 & 9430 Oakmore Rd",
      "addressLocality": "Los Angeles",
      "addressRegion": "CA",
      "postalCode": "90035",
      "addressCountry": "US"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Does this rental work with insurance ALE (Additional Living Expense) placements?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. 9432 Oakmore Rd accepts placements through insurance temporary-housing networks including ALE Solutions, CRS Temporary Housing, and Sedgwick. Minimum lease term is 6 months (12+ months for full rebuild timelines). Direct billing arrangements with the housing network or carrier are welcome."
        }
      },
      {
        "@type": "Question",
        "name": "Why choose a furnished house instead of a hotel during a rebuild?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "A displaced family living through a 1-3 year rebuild needs a home, not a room: full kitchen, laundry, separate bedrooms for children, a yard, parking, and neighborhood continuity. 9432 Oakmore Rd is offered unfurnished (furnishings by separate written agreement) and move-in ready — beds made, kitchen stocked with cookware, utilities active — so a family can transition within days of a claim approval."
        }
      },
      {
        "@type": "Question",
        "name": "Is the property suitable for observant Jewish families displaced from the Westside?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes — and this is rare in temporary housing inventory. The home has a kosher-configured kitchen (dual sinks, dual ovens), sits inside the LA Community Eruv, and is walking distance to Young Israel of Century City (0.4 mi), Beth Jacob Congregation (0.7 mi), and the Pico-Robertson kosher corridor. Displaced families can maintain full religious observance without disruption."
        }
      },
      {
        "@type": "Question",
        "name": "What lease terms are available for insurance placements?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "6-month minimum, with month-to-month continuation or fixed terms up to 12+ months. Rate is $23,950/month offered unfurnished (furnishings by separate written agreement), inclusive of furniture, appliances, and landscaping service. Insurance-network direct payment accepted. Extensions accommodated as rebuild timelines shift."
        }
      }
    ]
  }
];
---

<Layout
  image="/images/exterior-2.jpg"
  title="Insurance Temporary Housing Los Angeles | ALE-Ready 5BR Furnished Home — Beverlywood"
  description="ALE-compatible luxury rental for insurance-displaced families. Gated 5BR Beverlywood compound, kosher kitchen, guest house. 6-month minimum, $23,950/month. Works with ALE Solutions, CRS, Sedgwick. Call 424-272-5935."
  canonical="https://sevennova.ai/insurance-housing-los-angeles"
  jsonLd={jsonLd}
>
  <section class="relative py-28 bg-midnight-950 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-midnight-950 via-midnight-900 to-midnight-950"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <p class="text-amber-400 text-xs tracking-[0.4em] uppercase mb-4">ALE Compatible · 6-Month Minimum · Through Full Rebuild</p>
      <h1 class="font-display text-4xl md:text-5xl text-white leading-tight mb-6">
        Insurance Temporary Housing<br /><em class="text-gradient">Los Angeles</em>
      </h1>
      <p class="speakable text-slate-300 text-lg mb-8 max-w-2xl mx-auto leading-relaxed">
        9432 Oakmore Rd, Beverlywood 90035 — a offered unfurnished (furnishings by separate written agreement), gated 5-bedroom home ready for insurance ALE placements. Move-in ready for families displaced by fire or disaster: full kitchen, laundry, yard, guest house, kosher kitchen, walking-distance synagogues. 6-month minimum through 12+ month rebuild terms. Direct network billing accepted.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+14242725935" class="px-8 py-4 bg-amber-400 text-midnight-950 font-bold tracking-widest uppercase text-sm hover:bg-amber-300 transition-colors">Adjusters & Networks: 424-272-5935</a>
        <a href="/luxury-rental" class="px-8 py-4 border border-amber-400 text-amber-400 font-bold tracking-widest uppercase text-sm hover:bg-amber-400 hover:text-midnight-950 transition-colors">Full Property Details</a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-midnight-900">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-3xl text-white mb-8">For Adjusters &amp; Housing Coordinators</h2>
      <div class="space-y-6 text-slate-300 leading-relaxed">
        <p>This property is structured for insurance temporary-housing placements: offered unfurnished (furnishings by separate written agreement) and equipped (no setup period), 6-month minimum terms that extend month-to-month as rebuild schedules shift, separately metered guest house for extended family or care staff, and direct billing to the housing network or carrier on behalf of the insured.</p>
        <p>Placement coordinators from ALE Solutions, CRS Temporary Housing, Sedgwick, and adjuster-direct arrangements are welcome. Same-week move-in is typically possible. W-9, COI, and lease documentation turn around same-day.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center mt-10">
        {[
          ['5 + GH', 'Bedrooms + Guest House'],
          ['4,492', 'Sq Ft Furnished'],
          ['6 months', 'Minimum Term'],
          ['12+ mo', 'Extensions OK'],
        ].map(([val, label]) => (
          <div class="bg-midnight-950 p-5 border border-amber-400/10">
            <p class="font-display text-2xl text-amber-400">{val}</p>
            <p class="text-xs text-slate-500 tracking-widest uppercase mt-1">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-midnight-950">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="font-display text-3xl text-white mb-8">Why Displaced Families Choose This Home</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-slate-300">
        <div class="bg-midnight-900 p-6 border border-amber-400/10">
          <h3 class="font-display text-xl text-amber-400 mb-2">A Home, Not a Hotel</h3>
          <p class="text-sm">Full chef’s kitchen, in-unit laundry, private yard with heated pool, gated parking for 4 cars. Children keep routines; parents manage the rebuild from a real household.</p>
        </div>
        <div class="bg-midnight-900 p-6 border border-amber-400/10">
          <h3 class="font-display text-xl text-amber-400 mb-2">Westside Continuity</h3>
          <p class="text-sm">Beverlywood keeps displaced Westside families inside their school, work, and community orbit — 10 min to Beverly Hills, 15 to Century City, 15 to Cedars-Sinai.</p>
        </div>
        <div class="bg-midnight-900 p-6 border border-amber-400/10">
          <h3 class="font-display text-xl text-amber-400 mb-2">Observant-Family Ready</h3>
          <p class="text-sm">Kosher-configured kitchen (dual sinks/ovens), inside the LA Eruv, walking distance to Young Israel of Century City and Beth Jacob. Religious continuity through displacement.</p>
        </div>
        <div class="bg-midnight-900 p-6 border border-amber-400/10">
          <h3 class="font-display text-xl text-amber-400 mb-2">Multi-Generational Space</h3>
          <p class="text-sm">Detached 400 sq ft guest house with private entrance — grandparents, care staff, or a home office while the family occupies the 5BR main residence.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-midnight-900">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-3xl text-white mb-6">Place a Family This Week</h2>
      <p class="text-slate-300 mb-8">Daniel Issak · DRE #02037760 · Real Estate Source Inc. · Same-day documentation</p>
      <div class="flex flex-col md:flex-row gap-4 justify-center">
        <a href="tel:+14242725935" class="px-8 py-4 bg-amber-400 text-midnight-950 font-bold tracking-widest uppercase text-sm hover:bg-amber-300 transition-colors">Call 424-272-5935</a>
        <a href="https://wa.me/14242725935?text=Insurance%20housing%20placement%20inquiry%20-%209432%20Oakmore%20Rd" target="_blank" rel="noopener noreferrer" class="px-8 py-4 border border-green-500/40 bg-green-500/10 text-green-400 font-bold tracking-widest uppercase text-sm hover:bg-green-500/20 transition-colors">WhatsApp</a>
        <a href="/gallery" class="px-8 py-4 border border-slate-600 text-slate-300 font-bold tracking-widest uppercase text-sm hover:border-amber-400 hover:text-amber-400 transition-colors">57 Photos</a>
      </div>
    </div>
  </section>

  <RelatedLinks heading="Specialized Housing" links={[{"label": "Corporate Housing LA", "href": "/corporate-housing-los-angeles", "sub": "Executive relocation and corporate leases"}, {"label": "Executive Rental Beverly Hills", "href": "/executive-rental-beverly-hills", "sub": "C-suite furnished housing"}, {"label": "Production Housing LA", "href": "/production-housing-los-angeles", "sub": "Film and TV production stays"}, {"label": "Medical Stay Near Cedars-Sinai", "href": "/medical-stay-near-cedars-sinai", "sub": "Recovery and treatment housing"}, {"label": "Kosher Kitchen Luxury Rental", "href": "/kosher-kitchen-luxury-rental-los-angeles", "sub": "Dual sinks, dual ovens, walk to shul"}]} />
</Layout>
