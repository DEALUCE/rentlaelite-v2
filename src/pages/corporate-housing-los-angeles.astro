        <h2 class="font-display text-4xl text-white">Executive <em class="text-gradient">Proximity</em></h2>
        <p class="text-slate-500 text-sm mt-3">Drive times from 9432 Oakmore Rd, Beverlywood 90035</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px bg-midnight-800/50">
        <div class="glass-light p-6"><p class="text-white text-sm font-medium">Century City</p><p class="text-amber-400 font-display text-2xl mt-2">8 min</p><p class="text-slate-600 text-xs">3.2 mi</p></div>
        <div class="glass-light p-6"><p class="text-white text-sm font-medium">Beverly Hills</p><p class="text-amber-400 font-display text-2xl mt-2">10 min</p><p class="text-slate-600 text-xs">4.1 mi</p></div>
        <div class="glass-light p-6"><p class="text-white text-sm font-medium">Fox Studios</p><p class="text-amber-400 font-display text-2xl mt-2">7 min</p><p class="text-slate-600 text-xs">2.8 mi</p></div>
        <div class="glass-light p-6"><p class="text-white text-sm font-medium">Cedars-Sinai</p><p class="text-amber-400 font-display text-2xl mt-2">9 min</p><p class="text-slate-600 text-xs">3.5 mi</p></div>
        <div class="glass-light p-6"><p class="text-white text-sm font-medium">Sony Pictures</p><p class="text-amber-400 font-display text-2xl mt-2">12 min</p><p class="text-slate-600 text-xs">4.8 mi</p></div>
        <div class="glass-light p-6"><p class="text-white text-sm font-medium">Santa Monica</p><p class="text-amber-400 font-display text-2xl mt-2">15 min</p><p class="text-slate-600 text-xs">7.2 mi</p></div>
        <div class="glass-light p-6"><p class="text-white text-sm font-medium">West Hollywood</p><p class="text-amber-400 font-display text-2xl mt-2">12 min</p><p class="text-slate-600 text-xs">5.1 mi</p></div>
        <div class="glass-light p-6"><p class="text-white text-sm font-medium">LAX Airport</p><p class="text-amber-400 font-display text-2xl mt-2">20 min</p><p class="text-slate-600 text-xs">9.3 mi</p></div>
      </div>
    </div>
  </section>

  <section class="py-28 bg-midnight-950 border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Ready to <em class="text-gradient">Move In</em></h2>
      <p class="text-slate-400 max-w-xl mx-auto mb-10 leading-relaxed">9432 Oakmore Rd is available now, fully furnished. Corporate leases accepted. Contact Daniel Issak directly.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://calendly.com/theissakgroup/30min" target="_blank" rel="noopener noreferrer" class="bg-amber-400 text-midnight-950 font-semibold text-xs tracking-widest uppercase px-10 py-5 hover:bg-amber-300 transition-all duration-300 amber-glow-hover">Book Corporate Tour</a>
        <a href="https://wa.me/14242725935" target="_blank" rel="noopener noreferrer" class="border border-green-500/40 bg-green-500/10 text-green-400 text-xs tracking-widest uppercase px-10 py-5 hover:bg-green-500/20 transition-all duration-300">WhatsApp Daniel</a>
        <a href="tel:4242725935" class="border border-slate-600 text-slate-300 text-xs tracking-widest uppercase px-10 py-5 hover:border-amber-400 hover:text-amber-400 transition-all duration-300">Call 424-272-5935</a>
      </div>
      <p class="text-slate-600 text-xs mt-8">Daniel Issak - DRE #02037760 - Real Estate Source, Inc. - DRE #01869619</p>
    </div>
  </section>


  <RelatedLinks heading="Specialized Housing" links={[{"label": "Executive Rental Beverly Hills", "href": "/executive-rental-beverly-hills", "sub": "C-suite furnished housing"}, {"label": "Production Housing LA", "href": "/production-housing-los-angeles", "sub": "Film and TV production stays"}, {"label": "Medical Stay Near Cedars-Sinai", "href": "/medical-stay-near-cedars-sinai", "sub": "Recovery and treatment housing"}, {"label": "Insurance / ALE Housing", "href": "/insurance-housing-los-angeles", "sub": "Additional Living Expense placements"}, {"label": "Kosher Kitchen Luxury Rental", "href": "/kosher-kitchen-luxury-rental-los-angeles", "sub": "Dual sinks, dual ovens, walk to shul"}]} />
</Layout>
