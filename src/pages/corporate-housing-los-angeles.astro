---
import Layout from '../layouts/Layout.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import property from '../data/property.json';
const { agent } = property;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Accommodation",
    "name": "Corporate Housing Los Angeles 9432 Oakmore Rd Beverlywood",
    "description": "Premier corporate housing in Los Angeles. Fully furnished 5BR gated compound in Beverlywood, Beverly Hills adjacent. Executive relocation and extended stay from 34999 per month. 30-day minimum.",
    "url": "https://sevennova.ai/corporate-housing-los-angeles",
    "address": {"@type": "PostalAddress","streetAddress": "9432 Oakmore Rd","addressLocality": "Los Angeles","addressRegion": "CA","postalCode": "90035","addressCountry": "US"},
    "geo": {"@type": "GeoCoordinates","latitude": 34.05303,"longitude": -118.38756},
    "numberOfBedrooms": 5,
    "numberOfBathroomsTotal": 6,
    "offers": {"@type": "Offer","price": "34999","priceCurrency": "USD","availability": "https://schema.org/InStock"}
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type": "Question","name": "What is the best corporate housing in Los Angeles?","acceptedAnswer": {"@type": "Answer","text": "9432 Oakmore Rd in Beverlywood offers premier corporate housing - fully furnished gated 5BR compound with heated pool, detached guest house, EV charging. Beverly Hills adjacent, 30-day minimum, 34999 per month. Contact Daniel Issak at 424-272-5935."}},
      {"@type": "Question","name": "Does the corporate housing include furniture?","acceptedAnswer": {"@type": "Answer","text": "Yes. 9432 Oakmore Rd is fully furnished with curated luxury pieces throughout. Every room is staged and move-in ready including kitchen equipment."}},
      {"@type": "Question","name": "What is the minimum lease for corporate housing in LA?","acceptedAnswer": {"@type": "Answer","text": "30-day minimum. Preferred lease is 3-12 months. Corporate and executive relocation arrangements welcome. Contact Daniel Issak at 424-272-5935."}},
      {"@type": "Question","name": "How close is this corporate housing to Beverly Hills?","acceptedAnswer": {"@type": "Answer","text": "9432 Oakmore Rd is 10 minutes from Beverly Hills (4.1 mi), 8 minutes from Century City (3.2 mi), 7 minutes from Fox Studios, 9 minutes from Cedars-Sinai."}}
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem","position": 1,"name": "The Issak Group","item": "https://sevennova.ai/luxury-rental"},
      {"@type": "ListItem","position": 2,"name": "Corporate Housing Los Angeles","item": "https://sevennova.ai/corporate-housing-los-angeles"}
    ]
  }
];
---

<Layout
  image="/images/office.jpg"
  title="Corporate Housing Los Angeles | Fully Furnished 5BR Beverly Hills Adjacent | $34,999/mo"
  description="Premier corporate housing in Los Angeles - fully furnished gated 5BR compound in Beverlywood, Beverly Hills adjacent. Executive relocation, extended stay. 30-day minimum, $34,999/mo. Call 424-272-5935."
  canonical="https://sevennova.ai/corporate-housing-los-angeles"
  jsonLd={jsonLd}
>

  <div class="bg-amber-400 text-midnight-950 py-2.5 px-4 text-center">
    <p class="text-xs font-semibold tracking-[0.3em] uppercase">Corporate Housing - Beverly Hills Adjacent - Move-In Ready - 30-Day Minimum</p>
  </div>

  <section class="relative h-screen min-h-[700px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src={property.images.hero} alt="Corporate housing Los Angeles 9432 Oakmore Rd gated luxury compound Beverlywood" class="w-full h-full object-cover animate-ken-burns origin-center" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-r from-midnight-950/95 via-midnight-950/60 to-midnight-950/20"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-midnight-950 via-transparent to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
      <p class="text-amber-400 text-xs tracking-[0.4em] uppercase mb-4 flex items-center gap-3">
        <span class="w-8 h-px bg-amber-400"></span>
        Corporate Housing - Los Angeles CA 90035
      </p>
      <div class="inline-flex items-center gap-2.5 border border-amber-400 bg-amber-400/15 px-4 py-2 mb-6">
        <span class="text-amber-400 text-sm font-bold tracking-widest uppercase">Fully Furnished - Move-In Ready - 30-Day Minimum</span>
      </div>
      <h1 class="font-display text-5xl md:text-7xl leading-[1.05] mb-6">
        <span class="text-white">Corporate</span><br />
        <span class="text-white">Housing</span><br />
        <em class="text-gradient not-italic">Los Angeles</em>
      </h1>
      <p class="text-slate-300 text-lg leading-relaxed max-w-xl mb-8">
        The definitive executive residence for corporate relocations and extended stays in Los Angeles.
        5 bedrooms, heated pool, detached guest house - Beverly Hills adjacent.
      </p>
      <div class="flex flex-wrap gap-6 mb-10 items-end">
        <div class="text-center">
          <p class="font-display text-3xl text-amber-400">5</p>
          <p class="text-xs text-slate-500 tracking-widest uppercase">Beds</p>
        </div>
        <div class="text-center">
          <p class="font-display text-3xl text-amber-400">6</p>
          <p class="text-xs text-slate-500 tracking-widest uppercase">Baths</p>
        </div>
        <div class="text-center">
          <p class="font-display text-3xl text-amber-400">4492</p>
          <p class="text-xs text-slate-500 tracking-widest uppercase">Sq Ft</p>
        </div>
        <div class="w-px bg-midnight-700 self-stretch"></div>
        <div>
          <p class="font-display text-3xl text-white">$34,999</p>
          <p class="text-xs text-amber-400/70 tracking-widest uppercase">Per Month</p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="https://calendly.com/theissakgroup/30min" target="_blank" rel="noopener noreferrer" class="bg-amber-400 text-midnight-950 font-semibold text-xs tracking-widest uppercase px-8 py-4 hover:bg-amber-300 transition-all duration-300 amber-glow-hover">Schedule Corporate Tour</a>
        <a href="tel:4242725935" class="border border-slate-600 text-slate-300 text-xs tracking-widest uppercase px-8 py-4 hover:border-amber-400 hover:text-amber-400 transition-all duration-300">Call 424-272-5935</a>
      </div>
    </div>
  </section>

  <section class="bg-midnight-900 border-y border-white/5 py-6">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-midnight-800/30">
        <div class="glass-light px-6 py-4 flex items-center gap-4">
          <span class="text-amber-400 text-xl shrink-0">&#9672;</span>
          <div><p class="text-white text-xs font-semibold">DRE Licensed Agent</p><p class="text-slate-500 text-xs mt-0.5">Daniel Issak #02037760</p></div>
