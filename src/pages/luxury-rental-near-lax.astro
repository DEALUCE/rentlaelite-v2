---
import Layout from '../layouts/Layout.astro';
import RelatedLinks from '../components/RelatedLinks.astro';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "RealEstateListing",
    "name": "Luxury Rental Near LAX — 20 Minutes, Private Gated Compound | 9432 Oakmore Rd",
    "description": "Furnished luxury rental 20 minutes from LAX: 5BR/6BA gated compound in Beverlywood with heated pool, guest house, EV charging. $34,999/month, 30-day minimum — ideal for executives, crews, and international stays.",
    "url": "https://sevennova.ai/luxury-rental-near-lax",
    "price": "34999",
    "priceCurrency": "USD",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "9432 Oakmore Rd",
      "addressLocality": "Los Angeles",
      "addressRegion": "CA",
      "postalCode": "90035",
      "addressCountry": "US"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How far is 9432 Oakmore Rd from LAX?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Approximately 20 minutes by car (about 10 miles) via La Cienega Blvd or the 405 — close enough for early departures, far enough to escape airport noise and congestion, in residential Beverlywood."
        }
      },
      {
        "@type": "Question",
        "name": "Why choose a furnished rental near LAX instead of an airport hotel?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "For stays of 30 days or more, a private 4,492 sq ft compound with full kitchen, laundry, heated pool, and gated parking costs comparably to extended hotel stays while offering privacy, space for a family or team, and a residential neighborhood — with Beverly Hills 10 minutes away."
        }
      },
      {
        "@type": "Question",
        "name": "Who typically rents near LAX for a month or more?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "International executives on assignment, airline and aviation professionals, film crews flying in and out, relocating families, and event-driven stays such as Super Bowl LXI (February 2027) at SoFi Stadium — 18 minutes from the property."
        }
      }
    ]
  }
];
---

<Layout
  image="/images/exterior-1.jpg"
  title="Luxury Rental Near LAX | 20 Min — Furnished 5BR Gated Compound"
  description="Luxury furnished rental 20 minutes from LAX: gated 5BR compound in Beverlywood with heated pool, guest house, EV charging. $34,999/mo, 30-day minimum. 18 min to SoFi Stadium, 10 min to Beverly Hills."
  jsonLd={jsonLd}
>
  <section class="relative py-28 bg-midnight-950 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-midnight-950 via-midnight-900 to-midnight-950"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <p class="text-amber-400 text-xs tracking-[0.4em] uppercase mb-4">20 Min to LAX · 18 Min to SoFi · 10 Min to Beverly Hills</p>
      <h1 class="font-display text-4xl md:text-5xl text-white leading-tight mb-6">
        Luxury Rental<br /><em class="text-gradient">Near LAX</em>
      </h1>
      <p class="speakable text-slate-300 text-lg mb-8 max-w-2xl mx-auto leading-relaxed">
        9432 Oakmore Rd puts LAX 20 minutes away without living next to it — a fully
        furnished 5-bedroom gated compound in residential Beverlywood with heated pool,
        detached guest house, and EV charging. $34,999/month, 30-day minimum.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://calendly.com/theissakgroup/30min" target="_blank" rel="noopener noreferrer" class="bg-amber-400 text-midnight-950 text-xs font-semibold tracking-widest uppercase px-8 py-4 hover:bg-amber-300 transition-colors amber-glow-hover">Book a Private Tour</a>
        <a href="/property" class="border border-amber-400/40 text-amber-400 text-xs tracking-widest uppercase px-8 py-4 hover:border-amber-400 transition-colors">Property Details</a>
      </div>
    </div>
  </section>

  <section class="bg-midnight-900 py-16">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-xs tracking-widest uppercase text-amber-400 mb-8 text-center">Drive Times That Work</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-midnight-800/40">
        {[
          ['20 min', 'LAX Airport'],
          ['18 min', 'SoFi Stadium'],
          ['10 min', 'Beverly Hills'],
          ['8 min', 'Century City'],
          ['15 min', 'Culver City Studios'],
          ['12 min', 'Cedars-Sinai'],
          ['25 min', 'Santa Monica'],
          ['22 min', 'Hollywood'],
        ].map(([time, place]) => (
          <div class="glass-light p-6 text-center">
            <p class="font-display text-2xl text-amber-400">{time}</p>
            <p class="text-slate-400 text-xs mt-1 tracking-widest uppercase">{place}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-16">
    <div class="glass p-8 md:p-10">
      <h2 class="font-display text-2xl text-white mb-5">Airport-Close Without Airport Living</h2>
      <p class="text-slate-300 leading-relaxed mb-4">
        Hotels by LAX trade convenience for noise, traffic, and cramped rooms. 9432 Oakmore Rd
        offers the same practical access — 20 minutes door-to-terminal via La Cienega or the 405 —
        from a quiet, gated 4,492 sq ft compound in Beverlywood. Full chef's kitchen, in-unit
        laundry, heated pool and spa, and a detached guest house for staff or colleagues.
      </p>
      <p class="text-slate-400 leading-relaxed">
        For aviation professionals, international executives, and production teams cycling through
        LA, the 30-day minimum furnished lease is fully compliant with Los Angeles rental rules —
        no nightly-rental restrictions, clean corporate paperwork through a licensed DRE broker.
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-12 pb-20">
    <h2 class="font-display text-2xl text-white mb-8 text-center">Near-LAX Rental — FAQ</h2>
    <div class="space-y-4">
      {[
        { q: 'How far is the property from LAX?', a: 'About 20 minutes / 10 miles via La Cienega Blvd or the 405 — convenient for early flights without airport-zone noise.' },
        { q: 'Is parking and EV charging available?', a: 'Gated private driveway with automatic gate plus a dedicated EV charging station.' },
        { q: 'What is the minimum stay?', a: '30 days. Terms of 30/60/90 days up to 12+ months at $34,999/month, fully furnished.' },
      ].map(({ q, a }) => (
        <details class="glass group">
          <summary class="cursor-pointer list-none p-5 flex justify-between items-center gap-4">
            <span class="text-white text-sm font-medium">{q}</span>
            <span class="text-amber-400 group-open:rotate-45 transition-transform text-lg shrink-0">+</span>
          </summary>
          <p class="px-5 pb-5 text-sm text-slate-400 leading-relaxed">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <RelatedLinks heading="Location-Driven Stays" links={[
    { label: 'Luxury Rental Near SoFi', href: '/luxury-rental-near-sofi-stadium', sub: '18 minutes to SoFi Stadium' },
    { label: 'Super Bowl LXI 2027 Housing', href: '/super-bowl-2027-housing-los-angeles', sub: 'February 2027 window' },
    { label: 'Corporate Housing LA', href: '/corporate-housing-los-angeles', sub: 'Executive relocation leases' },
    { label: 'Production Housing LA', href: '/production-housing-los-angeles', sub: 'Film and TV production stays' },
    { label: 'Furnished Monthly Rental LA', href: '/furnished-monthly-rental-los-angeles', sub: '30/60/90-day terms' },
    { label: 'The Property', href: '/property', sub: 'Full specs and amenities' },
  ]} />
</Layout>
