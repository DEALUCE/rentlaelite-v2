---
import Layout from '../layouts/Layout.astro';
import property from '../data/property.json';
const { agent } = property;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Accommodation",
    "name": "Executive Rental Beverly Hills 9432 Oakmore Rd Beverlywood",
    "description": "Premier executive rental Beverly Hills adjacent. Fully furnished gated 5BR compound with heated pool, steam sauna, detached guest house, and kosher kitchen. 34999 per month, 30-day minimum.",
    "url": "https://sevennova.ai/luxury-rental/executive-rental-beverly-hills",
    "address": {"@type": "PostalAddress","streetAddress": "9432 Oakmore Rd","addressLocality": "Los Angeles","addressRegion": "CA","postalCode": "90035","addressCountry": "US"},
    "geo": {"@type": "GeoCoordinates","latitude": 34.05303,"longitude": -118.38756},
    "numberOfBedrooms": 5,
    "numberOfBathroomsTotal": 6,
    "offers": {"@type": "Offer","price": "34999","priceCurrency": "USD","availability": "https://schema.org/InStock"}
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {"@type": "Question","name": "What is the best executive rental in Beverly Hills?","acceptedAnswer": {"@type": "Answer","text": "9432 Oakmore Rd in Beverlywood is the premier executive rental adjacent to Beverly Hills - fully furnished gated 5BR compound with heated pool, steam sauna, detached guest house, and kosher kitchen. 34999 per month, 30-day minimum. Contact Daniel Issak at 424-272-5935."}},
      {"@type": "Question","name": "Is Beverlywood the same as Beverly Hills?","acceptedAnswer": {"@type": "Answer","text": "Beverlywood is directly adjacent to Beverly Hills, ZIP 90035. 10 minutes from Rodeo Drive. Same executive demographics and real estate values."}},
      {"@type": "Question","name": "How much does an executive rental in Beverly Hills cost?","acceptedAnswer": {"@type": "Answer","text": "Executive rental at 9432 Oakmore Rd is 34999 per month fully furnished. Security deposit 34999. 30-day minimum, preferred 3-12 months."}}
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem","position": 1,"name": "The Issak Group","item": "https://sevennova.ai/luxury-rental"},
      {"@type": "ListItem","position": 2,"name": "Executive Rental Beverly Hills","item": "https://sevennova.ai/luxury-rental/executive-rental-beverly-hills"}
    ]
  }
];
---

<Layout
  title="Executive Rental Beverly Hills | 9432 Oakmore Rd - 5BR Gated Compound, Pool, Guest House | $34,999/mo"
  description="Premier executive rental Beverly Hills adjacent - fully furnished gated 5BR compound in Beverlywood. Heated pool, steam sauna, guest house, kosher kitchen. $34,999/mo, 30-day minimum. Call 424-272-5935."
  canonical="https://sevennova.ai/luxury-rental/executive-rental-beverly-hills"
  jsonLd={jsonLd}
>

  <div class="bg-amber-400 text-midnight-950 py-2.5 px-4 text-center">
    <p class="text-xs font-semibold tracking-[0.3em] uppercase">Beverly Hills Adjacent - Fully Furnished - Gated - $34,999/mo</p>
  </div>

  <section class="relative h-screen min-h-[700px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src={property.images.hero} alt="Executive rental Beverly Hills 9432 Oakmore Rd gated luxury compound" class="w-full h-full object-cover animate-ken-burns origin-center" loading="eager" fetchpriority="high" />
      <div class="absolute inset-0 bg-gradient-to-r from-midnight-950/95 via-midnight-950/60 to-midnight-950/20"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-midnight-950 via-transparent to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-6 w-full">
      <p class="text-amber-400 text-xs tracking-[0.4em] uppercase mb-4 flex items-center gap-3">
        <span class="w-8 h-px bg-amber-400"></span>
        Beverly Hills Adjacent - Beverlywood CA 90035
      </p>
      <div class="inline-flex items-center gap-2.5 border border-amber-400 bg-amber-400/15 px-4 py-2 mb-6">
        <span class="text-amber-400 text-sm font-bold tracking-widest uppercase">Beverly Hills - 10 Minutes</span>
      </div>
      <h1 class="font-display text-5xl md:text-7xl leading-[1.05] mb-6">
        <span class="text-white">Executive</span><br />
        <span class="text-white">Rental</span><br />
        <em class="text-gradient not-italic">Beverly Hills</em>
      </h1>
      <p class="text-slate-300 text-lg leading-relaxed max-w-xl mb-8">
        The only gated executive compound in Beverlywood available for monthly lease.
        Beverly Hills adjacent - 10 minutes from Rodeo Drive, 8 from Century City.
      </p>
      <div class="flex flex-wrap gap-6 mb-10 items-end">
        <div class="text-center">
          <p class="font-display text-3xl text-amber-400">5</p>
          <p class="text-xs text-slate-500 tracking-widest uppercase">Beds</p>
        </div>
        <div class="text-center">
          <p class="font-display text-3xl text-amber-400">6</p>
          <p class="text-xs text-slate-500 tracking-widest uppercase">Baths</p>
        </div>
        <div class="text-center">
          <p class="font-display text-3xl text-amber-400">4492</p>
          <p class="text-xs text-slate-500 tracking-widest uppercase">Sq Ft</p>
        </div>
        <div class="w-px bg-midnight-700 self-stretch"></div>
        <div>
          <p class="font-display text-3xl text-white">$34,999</p>
          <p class="text-xs text-amber-400/70 tracking-widest uppercase">Per Month</p>
        </div>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="https://calendly.com/theissakgroup/30min" target="_blank" rel="noopener noreferrer" class="bg-amber-400 text-midnight-950 font-semibold text-xs tracking-widest uppercase px-8 py-4 hover:bg-amber-300 transition-all duration-300 amber-glow-hover">Book Private Showing</a>
        <a href="tel:4242725935" class="border border-slate-600 text-slate-300 text-xs tracking-widest uppercase px-8 py-4 hover:border-amber-400 hover:text-amber-400 transition-all duration-300">Call 424-272-5935</a>
      </div>
    </div>
  </section>

  <section class="py-28 bg-midnight-950">
    <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-20 items-center">
      <div>
        <p class="text-amber-400 text-xs tracking-[0.4em] uppercase mb-4 flex items-center gap-3"><span class="w-8 h-px bg-amber-400"></span>The Property</p>
        <h2 class="font-display text-4xl md:text-5xl text-white mb-8 leading-tight">Beverly Hills<br /><em class="text-gradient">Without Compromise</em></h2>
        <p class="text-slate-300 leading-relaxed mb-6">9432 Oakmore Rd sits in the coveted 90035 corridor - same executive ZIP as Beverly Hills, without the premium. Fully gated compound with separate guest house, steam sauna, heated pool, and kosher kitchen.</p>
        <div class="grid grid-cols-2 gap-3 mb-10 text-xs">
          <div class="flex items-center gap-2 text-slate-400"><span class="w-1 h-1 bg-amber-400 rounded-full shrink-0"></span>Heated pool and spa</div>
          <div class="flex items-center gap-2 text-slate-400"><span class="w-1 h-1 bg-amber-400 rounded-full shrink-0"></span>Steam sauna primary suite</div>
          <div class="flex items-center gap-2 text-slate-400"><span class="w-1 h-1 bg-amber-400 rounded-full shrink-0"></span>Detached guest house ADU</div>
          <div class="flex items-center gap-2 text-slate-400"><span class="w-1 h-1 bg-amber-400 rounded-full shrink-0"></span>Certified kosher kitchen</div>
          <div class="flex items-center gap-2 text-slate-400"><span class="w-1 h-1 bg-amber-400 rounded-full shrink-0"></span>EV charging station</div>
          <div class="flex items-center gap-2 text-slate-400"><span class="w-1 h-1 bg-amber-400 rounded-full shrink-0"></span>Ring security auto gate</div>
        </div>
        <div class="flex gap-4">
          <a href="/property" class="bg-amber-400 text-midnight-950 font-semibold text-xs tracking-widest uppercase px-7 py-3.5 hover:bg-amber-300 transition-all duration-300 amber-glow-hover">Full Details</a>
          <a href="/gallery" class="border border-slate-700 text-slate-300 text-xs tracking-widest uppercase px-7 py-3.5 hover:border-amber-400 hover:text-amber-400 transition-all duration-300">View Gallery</a>
        </div>
      </div>
      <div class="relative">
        <img src={property.images.primarySuite[0]} alt="Executive primary suite 9432 Oakmore Rd Beverly Hills adjacent" class="w-full aspect-[4/3] object-cover" loading="lazy" />
        <div class="absolute -bottom-6 -left-6 glass p-5 w-52">
          <p class="font-display text-3xl text-amber-400">90035</p>
          <p class="text-xs text-slate-400 tracking-widest uppercase mt-1">Beverly Hills Adjacent</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-28 bg-midnight-950 border-t border-white/5">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-display text-4xl md:text-5xl text-white mb-4">Your Beverly Hills <em class="text-gradient">Address Awaits</em></h2>
      <p class="text-slate-400 max-w-xl mx-auto mb-10 leading-relaxed">Available now. Fully furnished, move-in ready. 30-day minimum.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://calendly.com/theissakgroup/30min" target="_blank" rel="noopener noreferrer" class="bg-amber-400 text-midnight-950 font-semibold text-xs tracking-widest uppercase px-10 py-5 hover:bg-amber-300 transition-all duration-300 amber-glow-hover">Book Private Showing</a>
        <a href="https://wa.me/14242725935" target="_blank" rel="noopener noreferrer" class="border border-green-500/40 bg-green-500/10 text-green-400 text-xs tracking-widest uppercase px-10 py-5 hover:bg-green-500/20 transition-all duration-300">WhatsApp Daniel</a>
        <a href="tel:4242725935" class="border border-slate-600 text-slate-300 text-xs tracking-widest uppercase px-10 py-5 hover:border-amber-400 hover:text-amber-400 transition-all duration-300">Call 424-272-5935</a>
      </div>
      <p class="text-slate-600 text-xs mt-8">Daniel Issak - DRE #02037760 - Real Estate Source, Inc. - DRE #01869619</p>
    </div>
  </section>

</Layout>
