---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | The Issak Group — Beverly Hills Luxury Rentals"
  description="The page you’re looking for doesn’t exist. Explore 9432 Oakmore Rd — a furnished 5BR luxury gated compound in Beverlywood, Los Angeles."
>
  <section class="min-h-[70vh] flex items-center bg-midnight-950">
    <div class="max-w-3xl mx-auto px-6 text-center py-24">
      <p class="font-display text-7xl text-amber-400 mb-4">404</p>
      <h1 class="font-display text-3xl md:text-4xl text-white mb-6">This Page Doesn’t Exist</h1>
      <p class="text-slate-400 leading-relaxed mb-10 max-w-md mx-auto">
        The address you’re looking for isn’t here — but 9432 Oakmore Rd is.
        An unfurnished 5-bedroom gated compound in Beverlywood. Annual lease from $23,950/month, 6-month minimum.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
        <a href="/luxury-rental" class="bg-amber-400 text-midnight-950 text-xs font-semibold tracking-widest uppercase px-8 py-4 hover:bg-amber-300 transition-colors amber-glow-hover">Go to Homepage</a>
        <a href="/property" class="border border-amber-400/40 text-amber-400 text-xs tracking-widest uppercase px-8 py-4 hover:border-amber-400 transition-colors">View the Property</a>
      </div>
      <nav class="flex flex-wrap justify-center gap-x-6 gap-y-3 text-xs tracking-widest uppercase">
        {[['Gallery','/gallery'],['Super Bowl 2027','/super-bowl-2027-housing-los-angeles'],['Monthly Rentals','/furnished-monthly-rental-los-angeles'],['Zoning Guide','/zoning'],['Contact','/contact']].map(([label, href]) => (
          <a href={href} class="text-slate-500 hover:text-amber-400 transition-colors">{label}</a>
        ))}
      </nav>
    </div>
  </section>
</Layout>
